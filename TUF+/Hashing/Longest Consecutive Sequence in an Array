class Solution {
public:
//TC - O(3N)
//SC - O(N)
    int longestConsecutive(vector<int>& nums) {
        int n = nums.size();

        if(n == 0){
            return 0;
        }
        int longest = 1;

        unordered_set<int> temp;
        for(int i = 0; i < n; i++){
            temp.insert(nums[i]);
        }

        for(auto x : temp){
            if(temp.find(x-1) == temp.end()){
                int cnt = 1;
                int i = x;
                while(temp.find(i + 1) != temp.end()){
                    i = i + 1;
                    cnt = cnt+1;
                }
                longest = max(longest,cnt);
            }
        }
        return longest;
    }
};