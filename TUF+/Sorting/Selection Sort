class Solution {
public:
//Time Complexity - O(N2)
//Space Complexity - O(1)
    vector<int> selectionSort(vector<int>& nums) {
        int n = nums.size();
        for(int i = 0; i < n; i++){
            int minIndex = i;
            for(int j = i; j < n; j++){
                if(nums[j] < nums[minIndex]){
                    minIndex = j;
                }
            }
            swap(nums[i], nums[minIndex]);
        }
        return nums;
    }
};
