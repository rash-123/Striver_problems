class Solution {
public:
//nCr = n!/r!(n-r)!
//10C3 = 10*9*8/3*2*1 = 10/1 * 9/2 * 8/3

//TC - O(r)
//SC - O(1)
    int pascalTriangleI(int r, int c) {
        return nCr(r-1, c-1);
    }

    int nCr(int n, int r){
        if(r == 1){
            return n;
        }
        if(r > n-r){
            r = n-r;
        }
        long long res = 1;//take the largest datatype so it will not overflow
        for(int i = 0; i < r; i++){
            res = res*(n-i);
            res = res/(i+1);
        }
        return res;
    }
};