class Solution {
public:
//TC - O(N)
//SC - O(1)
    int maxSubArray(vector<int>& nums) {
        int maxi = INT_MIN;
        int n = nums.size();
        int currSum = 0;
        for(int i = 0; i < n; i++){
            currSum += nums[i];
            if(currSum > maxi){
                maxi = currSum;
            }
            if(currSum < 0){
                currSum = 0;
            }
        }
        return maxi;
    }
};