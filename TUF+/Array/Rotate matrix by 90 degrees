class Solution {
public:
//TC - O(N2) +O(N2)
//SC - O(N2)
    void rotateMatrix(vector<vector<int>>& matrix) {
        int n = matrix.size();
        int m = matrix[0].size();

        for(int i = 0; i < n; i++){
            for(int j = 0; j < i; j++){
                swap(matrix[i][j], matrix[j][i]);
            }
        }

        for(int i = 0; i < n; i++){
            int l = 0, r = n-1;
            while(l < r){
                swap(matrix[i][l], matrix[i][r]);
                l++;
                r--;
            }
        }
        
    }
};