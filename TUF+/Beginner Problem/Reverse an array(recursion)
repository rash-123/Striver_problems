// https://takeuforward.org/plus/data-structures-and-algorithm/beginner-problems/basic-recursion/reverse-an-array

class Solution{	
	public:
	//TC - O(N)
	//SC - O(N)
		vector<int> reverseArray(vector<int>& nums){			
			 reverse(nums,0, nums.size()-1);
			 return nums;
		}

		void reverse(vector<int>& nums, int left, int right){
			if(left >= right){
				return;
			}
			swap(nums[left], nums[right]);
			reverse(nums, left + 1, right - 1);
		}
};