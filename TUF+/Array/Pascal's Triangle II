class Solution {
public:
//Nth row = 1 5 10 10 5 1
//1 -> 1
//5 -> 5/1
//10 -> 5/1 * 4/2
//10 -> 5/1 * 4/2 * 3/3
//5 -> 5/1 * 4/2 * 3/3 * 2/4
//1 -> 5/1 * 4/2 * 3/3 * 2/4 * 1/5

//It can be seen that any element in the rth row is of the form:
//curr = (prev * (r-i))/(i)

//TC = O(r)
//SC = O(1)
    vector<int> pascalTriangleII(int r) {
        vector<int> ans(r);

        ans[0] = 1;

        for(int i = 1; i < r; i++){
            ans[i] = (ans[i-1] * (r-i))/(i);
        }

        return ans;
    }
};