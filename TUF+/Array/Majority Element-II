class Solution {
public:
//TC - O(N)
//SC - O(1)
    vector<int> majorityElementTwo(vector<int>& nums) {
        int n = nums.size();

        int ct1 = 0, ct2 = 0;
        int el1 = INT_MIN, el2 = INT_MIN;

        for(int i = 0; i < n; i++){
            if(ct1 == 0 && el2 != nums[i]){
                ct1 = 1;
                el1 = nums[i];
            }
            else if(ct2 == 0 && el1 != nums[i]){
                ct2 = 1;
                el2 = nums[i];
            }
            else if(el1 == nums[i]){
                ct1++;
            }
            else if(el2 == nums[i]){
                ct2++;
            }
            else{
                ct1--;
                ct2--;
            }
        }

        int cnt1 = 0, cnt2 = 0;
        for(int i = 0; i < n; i++){
            if(el1 == nums[i]){
                cnt1++;
            }
            if(el2 == nums[i]){
                cnt2++;
            }
        }

        vector<int> result;
        if(cnt1 > n/3){
            result.push_back(el1);
        }
        if(cnt2 > n/3 && el2 != el1){
            result.push_back(el2);
        }

        return result;
    }
};