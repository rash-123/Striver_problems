// https://takeuforward.org/plus/data-structures-and-algorithm/sorting/algorithms/bubble-sort

class Solution {
public:
//Time Complexity - O(N2)
//Space Complexity - O(1)
    vector<int> bubbleSort(vector<int>& nums) {
        int n = nums.size();
        for(int i = 0; i < n; i++){
            for(int j = i; j < n; j++){
                if(nums[j] < nums[i]){
                    swap(nums[i], nums[j]);
                }
            }
        }
        return nums;
    }
};
