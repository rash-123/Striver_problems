class Solution {
public:
//TC - O(N)
//SC - O(N)
    vector<int> twoSum(vector<int>& nums, int target) {
        int n = nums.size();
        unordered_map<int,int> freq;
        for(int i = 0; i < n; i++){
            int b = target - nums[i];
            if(freq.find(b) != freq.end()){
               return {freq[b], i};
            }
            freq[nums[i]] = i;
        }
        return {-1, -1};
    }
};